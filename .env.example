# Copy to .env (gitignored) for local dev. In CI these come from GitHub
# repo Settings → Secrets and variables → Actions.

# Supabase project URL — same value as virtual-desk's NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Supabase service-role key. Bypasses RLS; never paste this into a public
# Vercel/Next.js env. Find it at: Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_KEY=

# Anthropic API key for Claude Haiku (default translation provider). Create a
# key dedicated to this worker (Claude Console -> API keys) so it can be
# revoked on its own.
ANTHROPIC_API_KEY=

# Translation provider: claude (default when empty) or gemini (fallback).
TRANSLATE_PROVIDER=

# Google AI Studio key for Gemini — only used when TRANSLATE_PROVIDER=gemini.
GEMINI_API_KEY=

# Google Cloud API key restricted to YouTube Data API v3 (streams step only).
# Free quota 10k units/day; a run uses ~1 unit per 50 video ids.
YOUTUBE_API_KEY=

# rss.app feed ids, as one JSON object: feed key -> id (the part before .xml in
# https://rss.app/feeds/<id>.xml). Keys used by scripts/fetch.ts and streams.ts:
# official-kaf official-info fan-top fan-latest kafu rim harusaruhi isekaijoucho koko ciel asu
RSS_FEEDS=
